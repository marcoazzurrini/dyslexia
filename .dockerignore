# Allowlist build inputs; never send local credentials or narration to Docker.
**
!Dockerfile.verify
!.dockerignore
!.gitignore
!.node-version
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!playwright.config.ts
!wrangler.jsonc
!lefthook.yml
!oxfmt.config.ts
!oxlint.config.ts
!README.md
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/**
!containers/
!containers/**
!tests/
!tests/**
!docs/
!docs/**
!.github/
!.github/**

# These stay excluded even if placed inside an allowlisted directory.
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*
**/secrets/
**/node_modules/
**/*.pem
**/*.key
**/*.mp3
**/*.wav
**/*.m4a
**/*.flac
**/*.ogg
**/*.opus
