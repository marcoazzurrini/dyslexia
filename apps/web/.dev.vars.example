# Server-side keys only. Never use a VITE_ prefix or commit .env.
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
# Optional: defaults to George, the voice used for the first recording.
ELEVENLABS_VOICE_ID=
# Password entered in the web app. Keep it private; sign-in is rate-limited.
PIPELINE_ACCESS_TOKEN=
# Separate server-only signing key: at least 32 random characters.
# Never enter this key in the web app.
PIPELINE_SIGNING_SECRET=
