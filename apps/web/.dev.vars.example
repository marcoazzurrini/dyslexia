# Local development secrets. Copy to .dev.vars; never commit it or use a VITE_ prefix.
# Production sets these with `wrangler secret put`.
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
# Optional. A Honeycomb ingest key for the development environment, so local
# traces stay apart from production's.
HONEYCOMB_API_KEY=
# Optional. Langfuse project keys, to trace narration runs. Without them,
# narrations are not traced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps local runs apart from production in Langfuse.
LANGFUSE_TRACING_ENVIRONMENT=development
# Google sign-in: the OAuth client's ID and secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Overrides the production URL in wrangler.jsonc.
BETTER_AUTH_URL=http://localhost:3000
