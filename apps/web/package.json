{
  "name": "@dyslexia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./screens/*": "./src/screens/*.tsx",
    "./player/*": "./src/player/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./contracts": "./src/pipeline/contracts.ts"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@dyslexia/auth": "workspace:*",
    "@dyslexia/mp3": "workspace:*",
    "@dyslexia/ui": "workspace:*",
    "@elevenlabs/elevenlabs-js": "2.70.0",
    "@openrouter/sdk": "1.4.18",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "@videojs/react": "10.0.0-rc.4",
    "effect": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  }
}
