{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dyslexia",
  "account_id": "168a8fd9b88ae669c145fa229de911c5",
  "workers_dev": true,
  "routes": [
    { "pattern": "dyslexia.marcoazzurrini.com", "custom_domain": true },
  ],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
  "assets": {
    // Let the application handle missing paths; asset-level SPA fallback
    // would turn missing images/scripts into successful HTML responses.
    "run_worker_first": ["/api/pipeline/*", "/audio/*"],
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "dyslexia-audio" }],
  "ratelimits": [
    {
      "name": "PIPELINE_LOGIN_LIMIT",
      "namespace_id": "19381",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "workflows": [
    {
      "binding": "NARRATION",
      "name": "dyslexia-narration",
      "class_name": "NarrationWorkflow",
    },
  ],
  // Retired audio assembler container. Remove this entry once a deploy
  // reports the tombstone as stale.
  "exports": {
    "AudioAssembler": { "type": "durable-object", "state": "deleted" },
  },
}
