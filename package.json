{
  "name": "dyslexia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "storybook": "bun run --cwd apps/demo dev",
    "build": "bun run --if-present --workspaces build",
    "typecheck": "bun run --if-present --workspaces typecheck",
    "test": "bun run --if-present --workspaces test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings && node apps/web/scripts/check-screens.ts",
    "lint:fix": "oxlint --fix --deny-warnings"
  },
  "devDependencies": {
    "lefthook": "2.1.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "ultracite": "7.12.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.2"
}
