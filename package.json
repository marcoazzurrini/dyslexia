{
  "name": "dyslexia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "ci": "npm run format:check && npm run lint && npm run test:scripts && npm run build && npm run typecheck && npm test",
    "verify": "node scripts/verify.mjs",
    "test:container": "node scripts/verify.mjs browser",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "narrate": "node scripts/narration.mjs",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "prepare": "node scripts/install-hooks.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "npm run ci && npm run deploy:only",
    "deploy:only": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "media-chrome": "4.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lefthook": "2.1.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
