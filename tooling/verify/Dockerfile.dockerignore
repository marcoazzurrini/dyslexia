# Allowlist build inputs; never send local credentials or narration to Docker.
**
!.github/
!.github/**
!.gitignore
!.node-version
!README.md
!package.json
!bun.lock
!tsconfig.base.json
!lefthook.yml
!oxfmt.config.ts
!oxlint.config.ts
!apps/
!apps/**
!docs/
!docs/**
!tooling/
!tooling/**

# These stay excluded even inside an allowlisted directory.
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/.dev.vars.*
**/secrets/
**/node_modules/
**/.wrangler/
**/.tanstack/
**/dist/
**/test-results/
**/*.pem
**/*.key
**/*.mp3
**/*.wav
**/*.m4a
**/*.flac
**/*.ogg
**/*.opus
